{
  "name": "neuroquiz-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Windows desktop shell for NeuroQuiz",
  "main": "main.cjs",
  "scripts": {
    "copy-web": "node -e \"require('fs').rmSync('app',{recursive:true,force:true});require('fs').cpSync('../dist','app',{recursive:true})\"",
    "start": "npm run copy-web && electron .",
    "dist:win": "npm run copy-web && electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "org.neuroquiz.desktop",
    "productName": "NeuroQuiz",
    "files": ["main.cjs", "app/**/*"],
    "directories": { "output": "dist" },
    "win": { "target": ["nsis", "portable"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
